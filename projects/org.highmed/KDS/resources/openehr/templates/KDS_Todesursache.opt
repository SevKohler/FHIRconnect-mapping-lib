    </annotations>
    <annotations path="[openEHR-EHR-COMPOSITION.report.v1]/content[openEHR-EHR-EVALUATION.cause_of_death.v1]/protocol[at0014]/items[at0015]">
        <items id="fhir_mapping">Condition.recordedDate</items>
    </annotations>
    <annotations path="[openEHR-EHR-COMPOSITION.report.v1]/content[openEHR-EHR-EVALUATION.cause_of_death.v1]/data[at0001]/items[openEHR-EHR-CLUSTER.problem_qualifier.v2]/items[at0107, 'Klinischer Status']">
        <items id="fhir_mapping">Condition.clinicalStatus</items>
    </annotations>
</template>
